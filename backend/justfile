# odpalać za pomocą:
# just <command>

# ładuje dane z .env
set dotenv-load := true

default:
    @echo "Commands:"
    @echo ""
    @just --list


# DEV
# ===

# tworzy venv'a i instaluje wszystkie dev biblioteki
install:
    uv venv && uv sync --all-extras

# odpal code check
check:
    uv run ruff check

# formatuj
lint:
    uv run ruff format


# DATABASE
# ========

# odpal kontener bazy danych
db-up:
    docker compose up -d timescaledb

# zatrzymaj kontener bazy i usuń dane
db-reset:
   docker compose down -v timescaledb

# odpal postgres shell
db-shell:
    @docker compose exec timescaledb psql -U {{env_var("POSTGRES_USER")}} -d {{env_var("POSTGRES_DB")}}


# zrób bakup calej bazy
db-dump file="netwalk.bak":
    @docker compose exec -T timescaledb pg_dump -U {{env_var("POSTGRES_USER")}} -F c -d {{env_var("POSTGRES_DB")}} > {{file}}

# załaduj backup bazy
db-load file="netwalk.bak":
    @docker compose exec -T timescaledb pg_restore -U {{env_var("POSTGRES_USER")}} --clean --if-exists -d {{env_var("POSTGRES_DB")}} < {{file}}

# SERVER
# ======

# odpal shell w kontenerze api
api-shell:
    docker compose exec api /bin/bash


# FULL STACK
# ==========

# odpala db + server
up-full:
    @echo "Starting full stack in docker"
    docker compose up --build


# zatrzymaj cały serwis ale zachowaj baze
down:
    docker compose down

# zatrzymaj cały serwis i usuń dane
down-remove:
    docker compose down -v


# TESTS
# =====

# odpal serwer healthcheck
test-health:
    curl -s http://localhost:8000/health | jq .

# test wysyłania
test-batch:
    curl -X POST http://localhost:8000/measurements/batch \
    -H "Content-Type: application/json" \
    -d @tests/data/example_payload.json \
    | jq .

# test ostatnich przesłanych
test-get:
    curl -s http://localhost:8000/measurements | jq '.[:2]'

# pełny test
test-all: test-health test-batch test-get
    @echo "Tests passed"


# UTILITIES
# =========

# pokaż status serwisóœ
status:
    docker compose ps

# pokaż logi API
logs-api:
    docker compose logs -f api

# pokaż logi bazu
logs-db:
    docker compose logs -f timescaledb

# wyczyść cahce buildu dockera
docker-clean:
    docker builder prune -f
